#!/usr/bin/python3
#
# pyra-sound — a sound icon for the MATE Notification Area on the DragonBox
# Pyra. Runs as the logged-in user, needs no root.
#
# WHY THIS EXISTS
#
# The Pyra's headphone jack can't report an unplug, so MATE's own sound icon
# can't switch back to the speakers by itself. This icon switches outputs by
# hand (see docs/audio-stack.md in the source tree).
#
# USING IT
#
#   left click               mute / unmute
#   right click              output (speakers / headphones), the wheel's
#                            volume (read only), and a headphone volume
#                            slider when the volume wheel doesn't drive the
#                            headphones (an older pyra_volumed, or none
#                            running)
#
# It talks to PulseAudio through pactl, on the AESS kernels' single sink
# "aess". On a kernel with the direct McPDM path it says "unsupported" on
# stderr and exits without an icon.
#
# INSTALLING
#
# The pyra-sound package starts it at login from /etc/xdg/autostart. Only one
# copy runs: a second start finds the first on the session bus and exits.
#
# Copyright (C) 2026 the pyra-sound authors
# SPDX-License-Identifier: GPL-2.0-or-later
#
import json
import os
import shutil
import signal
import sys
import warnings

import gi
gi.require_version("Gdk", "3.0")
gi.require_version("Gtk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk

# Gtk.StatusIcon is deprecated in GTK 3, but it is what MATE's Notification
# Area shows, and the icon this one replaces uses it too.
warnings.filterwarnings("ignore", message="Gtk.StatusIcon", category=DeprecationWarning)

APP_ID = "org.pyra.Sound"
SINK = "aess"
SPEAKER, HEADPHONES = "pyra-speaker", "pyra-headphones"
PORT_NAMES = {SPEAKER: "speakers", HEADPHONES: "headphones"}

# The headphone amp's volume, 0..15 (-30..0 dB). pyra_volumed writes it from
# the wheel (dragonbox-pyra's build, pyra-hacks' from 0.38+pyra2); older
# packaged ones don't.
# Never write "Handsfree Playback Volume": pyra_volumed owns that one.
CARD = "L15"
HEADSET_VOLUME = "Headset Playback Volume"
HEADSET_MAX = 15

# The speaker amp's volume, 0..29 (-52..+6 dB), which pyra_volumed sets from
# the wheel on every move. We only read it.
HANDSFREE_VOLUME = "Handsfree Playback Volume"
HANDSFREE_MAX = 29


# pyra_volumed's settings file (pyra-hacks' builds from 0.38+pyra1). Its
# "range lo hi" lines say which Handsfree steps the wheel spans.
VOLUMED_CONFIG = "/etc/pyra_volumed.conf"


def volumed_binary():
    """The running pyra_volumed's binary, or None. Its process is root's, so
    /proc/PID/exe is closed to us; take the path from argv[0]."""
    for pid in filter(str.isdigit, os.listdir("/proc")):
        try:
            with open(f"/proc/{pid}/comm") as f:
                if f.read().strip() != "pyra_volumed":
                    continue
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                argv0 = f.read().split(b"\0")[0].decode()
            path = argv0 if "/" in argv0 else shutil.which(argv0)
            with open(path, "rb") as f:
                return f.read()
        except (OSError, TypeError, UnicodeDecodeError):
            continue
    return None


def config_range(lo, hi):
    """The Handsfree span from VOLUMED_CONFIG's "range lo hi" lines, read the
    way pyra_volumed reads them: the last valid one wins, invalid ones are
    ignored, no file leaves the defaults."""
    try:
        with open(VOLUMED_CONFIG) as f:
            lines = f.readlines()
    except FileNotFoundError:
        return lo, hi
    except OSError as e:
        log(f"{VOLUMED_CONFIG}: {e.strerror}; assuming range {lo} {hi}")
        return lo, hi
    for line in lines:
        words = line.split()
        if len(words) < 3 or words[0] != "range":
            continue
        try:
            a, b = int(words[1]), int(words[2])
        except ValueError:
            continue
        if 0 <= a < b <= HANDSFREE_MAX:
            lo, hi = a, b
    return lo, hi


def read_wheel():
    """What the running pyra_volumed does with the wheel: whether it drives
    the headphones, and the Handsfree steps (lo, hi) its travel spans, which
    turn a Handsfree reading back into the wheel's position.

    The headphones: the full control name is in dragonbox-pyra's build, the
    simple mixer element "Headset" in pyra-hacks' (0.38+pyra2 on). The span:
    pyra-hacks' builds that read VOLUMED_CONFIG default to 6..29, so does
    dragonbox-pyra's (hard-coded); stock 0.38 maps the wheel onto 0..29 (see
    docs/audio-stack.md, "Volume wheel: pyra_volumed")."""
    binary = volumed_binary()
    if binary is None:
        return False, (0, HANDSFREE_MAX)
    drives = any(n in binary for n in (HEADSET_VOLUME.encode(), b"\0Headset\0"))
    if VOLUMED_CONFIG.encode() in binary:
        span = config_range(6, HANDSFREE_MAX)
    elif HEADSET_VOLUME.encode() in binary:
        span = (6, HANDSFREE_MAX)
    else:
        span = (0, HANDSFREE_MAX)
    return drives, span


def amixer_value(out):
    """The first channel's value from amixer cget output ("  : values=13,13"),
    or None."""
    for line in out.splitlines():
        if line.strip().startswith(": values="):
            try:
                return int(line.split("=")[1].split(",")[0])
            except ValueError:
                return None
    return None

# The same full-colour theme icons mate-volume-control-status-icon uses, so
# this one looks like the icon it replaces. MATE picks one of the three by the
# sink volume in thirds of 100%; icon_for() does the same. MATE's icons don't
# show the output, so the headphones get the theme's headphones picture.
ICONS = ("audio-volume-muted", "audio-volume-low",
         "audio-volume-medium", "audio-volume-high")
HEADPHONES_ICON = "audio-headphones"


def icon_for(muted, percent, port=None):
    if muted or percent <= 0:
        return ICONS[0]
    if port == HEADPHONES:
        return HEADPHONES_ICON
    return ICONS[min(3, max(1, percent * 3 // 100 + 1))]


def log(msg):
    print(f"pyra-sound: {msg}", file=sys.stderr, flush=True)


def aess_kernel():
    """True on the AESS path. Its front end shows up as a "MultiMedia1 LP"
    PCM; the direct McPDM path has no such device."""
    try:
        with open("/proc/asound/pcm") as f:
            return "MultiMedia1 LP" in f.read()
    except OSError:
        return False


def watcher(argv):
    """Start a long-lived child whose stdout we read line by line. setpriv
    (util-linux, Essential) asks the kernel to SIGTERM it when we die: at
    logout the X connection drops and GDK exits without do_shutdown(), and
    "pactl subscribe" ignores SIGPIPE, so it would outlive us for good and
    hold the old login session open (NEXT 2.3)."""
    return Gio.Subprocess.new(["setpriv", "--pdeathsig", "TERM", *argv],
                              Gio.SubprocessFlags.STDOUT_PIPE)


def run(argv, done=None):
    """Run a command without blocking the main loop. done(ok, stdout) is
    called when it finishes."""
    try:
        proc = Gio.Subprocess.new(
            argv, Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE)
    except GLib.Error as e:
        log(f"{argv[0]}: {e.message}")
        if done:
            done(False, "")
        return

    def finished(proc, result):
        try:
            _, out, err = proc.communicate_utf8_finish(result)
        except GLib.Error as e:
            log(f"{argv[0]}: {e.message}")
            out, err = "", ""
        ok = proc.get_successful()
        if not ok and err:
            log(f"{' '.join(argv)}: {err.strip()}")
        if done:
            done(ok, out or "")

    proc.communicate_utf8_async(None, None, finished)


class PyraSound(Gtk.Application):

    def __init__(self):
        super().__init__(application_id=APP_ID)
        self.icon = None
        self.popup = None
        self.port = None          # last port seen, to notice a switch
        self.monitor = None       # the alsactl monitor process
        self.subscribe = None     # the pactl subscribe process
        self.refresh_queued = False
        self.pa = (False, 100, None)  # PA's mute, volume and port
        self.amp = {}             # amp volume control -> its last value
        self.drives_headset = True  # pyra_volumed drives the headphones
        self.span = (0, HANDSFREE_MAX)  # Handsfree steps the wheel spans

    def do_startup(self):
        Gtk.Application.do_startup(self)
        # No windows, so keep the application alive by hand.
        self.hold()
        self.icon = Gtk.StatusIcon(title="Sound")
        self.icon.connect("activate", self.on_activate)
        self.icon.connect("popup-menu", self.on_popup_menu)
        self.popup = Popup(self)
        self.show(False, 100)
        self.refresh()
        self.read_amp(HANDSFREE_VOLUME)
        self.read_amp(HEADSET_VOLUME)
        self.check_wheel()
        if not self.drives_headset:
            log("pyra_volumed doesn't drive the headphones; "
                "the popup gets a headphone volume slider")
        self.watch_mixer()
        self.watch_pulse()
        for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
            GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, sig, self.on_signal)

    def do_shutdown(self):
        for proc in (self.monitor, self.subscribe):
            if proc:
                proc.force_exit()
        Gtk.Application.do_shutdown(self)

    def on_signal(self):
        self.quit()
        return GLib.SOURCE_REMOVE

    def do_activate(self):
        # A second start lands here, in the first process. Nothing to do.
        pass

    def on_activate(self, _icon):
        run(["pactl", "set-sink-mute", SINK, "toggle"],
            lambda ok, out: self.refresh())

    def on_popup_menu(self, _icon, _button, _time):
        if self.popup.get_visible():
            self.popup.close()
        else:
            self.popup.open()

    def check_wheel(self):
        """Look at the running pyra_volumed again: it can be swapped,
        restarted or given a new range under a running session. Done at
        start and on every popup open, not on every wheel event."""
        self.drives_headset, self.span = read_wheel()
        self.show(*self.pa)

    def volume(self):
        """The loudness as a share of 0..1, or None before the first read.
        Normally the wheel's position, the same on both outputs: Handsfree
        follows the wheel on every turn whichever port plays, and every
        pyra_volumed writes it, so it is read back through the daemon's span
        (off writes 0, below lo, so the bottom stop is 0). On the headphones
        with a daemon that doesn't drive them, the popup slider's value."""
        if self.pa[2] == HEADPHONES and not self.drives_headset:
            value = self.amp.get(HEADSET_VOLUME)
            return None if value is None else value / HEADSET_MAX
        value = self.amp.get(HANDSFREE_VOLUME)
        if value is None:
            return None
        lo, hi = self.span
        return min(1, max(0, (value - lo) / (hi - lo)))

    def set_port(self, port):
        run(["pactl", "set-sink-port", SINK, port], lambda ok, out: self.refresh())

    def refresh(self):
        """Read mute, volume and the active port back from PulseAudio and show
        them. PA is the only record of the state; MATE's sound preferences or
        pactl can change it behind our back."""
        def got_sinks(ok, out):
            if not ok:
                return
            try:
                sink = next(s for s in json.loads(out) if s["name"] == SINK)
                percent = int(next(iter(sink["volume"].values()))
                              ["value_percent"].rstrip("%"))
                muted, port = sink["mute"], sink["active_port"]
            except (ValueError, KeyError, StopIteration, AttributeError) as e:
                log(f"can't read sink {SINK} from pactl: {e!r}")
                return
            self.show(muted, percent, port)
            self.port = port
        run(["pactl", "-f", "json", "list", "sinks"], got_sinks)

    def watch_mixer(self):
        """Follow the amp volumes for the tooltip with "alsactl monitor", which
        blocks in the kernel and prints one line per change, so nothing runs
        while the wheel is still. Lines look like
        "node hw:L15, #30 (2,0,0,Handsfree Playback Volume,0) VALUE"."""
        # alsa-utils installs alsactl in /usr/sbin, off a normal user's PATH.
        # (amixer events would do too, but it buffers its output in a pipe.)
        try:
            self.monitor = watcher(["/usr/sbin/alsactl", "monitor", f"hw:{CARD}"])
        except GLib.Error as e:
            log(f"alsactl monitor: {e.message}; the tooltip won't follow the wheel")
            return
        stream = Gio.DataInputStream.new(self.monitor.get_stdout_pipe())

        def got_line(stream, result):
            try:
                line, _ = stream.read_line_finish_utf8(result)
            except GLib.Error as e:
                log(f"alsactl monitor: {e.message}")
                line = None
            if line is None:
                # alsactl ended. Start it again, but not in a tight loop.
                log("alsactl monitor stopped; restarting it in 5 s")
                self.monitor = None
                GLib.timeout_add_seconds(5, lambda: self.watch_mixer() and False)
                return
            for control in (HANDSFREE_VOLUME, HEADSET_VOLUME):
                if f",{control}," in line:
                    self.read_amp(control)
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, got_line)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, got_line)

    def watch_pulse(self):
        """Follow PulseAudio's state with "pactl subscribe", which waits on
        the server and prints one line per event, so outside changes (pactl,
        MATE's sound preferences) show up without polling. Mute, volume and
        port changes all come as "Event 'change' on sink #0"; our own pactl
        calls only add "client" events, so refreshing doesn't feed itself."""
        try:
            self.subscribe = watcher(["pactl", "subscribe"])
        except GLib.Error as e:
            log(f"pactl subscribe: {e.message}; outside changes won't show")
            return
        stream = Gio.DataInputStream.new(self.subscribe.get_stdout_pipe())

        def got_line(stream, result):
            try:
                line, _ = stream.read_line_finish_utf8(result)
            except GLib.Error as e:
                log(f"pactl subscribe: {e.message}")
                line = None
            if line is None:
                # PulseAudio went away (or pactl did). Try again, slowly, and
                # read the state afresh once it's back.
                log("pactl subscribe stopped; restarting it in 5 s")
                self.subscribe = None
                GLib.timeout_add_seconds(5, lambda: self.watch_pulse() and False)
                return
            if " on sink #" in line or " on server" in line:
                self.queue_refresh()
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, got_line)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, got_line)
        self.queue_refresh()

    def queue_refresh(self):
        """One refresh for a burst of PA events (a volume drag in MATE's
        preferences sends dozens), 100 ms after the first."""
        if self.refresh_queued:
            return
        self.refresh_queued = True

        def fire():
            self.refresh_queued = False
            self.refresh()
            return GLib.SOURCE_REMOVE
        GLib.timeout_add(100, fire)

    def read_amp(self, control):
        """Read an amp volume (speakers or headphones) for the tooltip."""
        def got(ok, out):
            value = amixer_value(out) if ok else None
            if value is None:
                log(f"can't read {control}: {out.strip()}")
                return
            self.amp[control] = value
            self.show(*self.pa)
        run(["amixer", "-c", CARD, "cget", f"name={control}"], got)

    def show(self, muted, percent, port=None):
        self.pa = (muted, percent, port)
        self.icon.set_from_icon_name(icon_for(muted, percent, port))
        if port in PORT_NAMES:
            self.popup.show_port(port)
        # The loudness is the wheel's position (or, on the headphones with an
        # older pyra_volumed, the popup's slider). PA's volume normally stays
        # at 100%, so it's only worth mentioning when someone has moved it.
        output = "Headphones" if port == HEADPHONES else "Speakers"
        volume = self.volume()
        if muted:
            text = f"{output}: muted"
        elif volume is not None:
            text = f"{output}: {round(volume * 100)}%"
        else:
            text = output
        if not muted and percent != 100:
            text += f" (PulseAudio {percent}%)"
        self.icon.set_tooltip_text(text)
        self.popup.show_level(port == HEADPHONES, volume)


class Popup(Gtk.Window):
    """The right-click window: output choice, the wheel's volume (a bar, read
    only: pyra_volumed owns it), and the headphone volume when the wheel
    doesn't drive it.

    A window rather than a Gtk.Menu, because a Gtk.Scale inside a menu item
    doesn't get its drags; MATE's own sound icon pops up a window too. It
    grabs the pointer and closes on a click outside it or on Escape."""

    def __init__(self, app):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.app = app
        self.updating = False     # set while we move the widgets ourselves
        self.hs_pending = None    # headset value waiting to be written
        self.hs_busy = False      # an amixer write is running
        self.level_on_hp = False  # the bar shows the headphones' level

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6,
                      border_width=10)
        self.speaker = Gtk.RadioButton.new_with_label(None, "Speakers")
        self.headphones = Gtk.RadioButton.new_with_label_from_widget(
            self.speaker, "Headphones")
        for button, port in ((self.speaker, SPEAKER), (self.headphones, HEADPHONES)):
            button.connect("toggled", self.on_port_toggled, port)
            box.pack_start(button, False, False, 0)
        # The wheel's position, the same on both outputs. A LevelBar, not a Scale:
        # Handsfree is pyra_volumed's alone, and dragging would fight it.
        self.level = [Gtk.Separator(), Gtk.Box(spacing=6)]
        self.level_label = Gtk.Label(label="Volume", xalign=0)
        self.level_value = Gtk.Label(xalign=1)
        self.level[1].pack_start(self.level_label, True, True, 0)
        self.level[1].pack_start(self.level_value, False, False, 0)
        self.bar = Gtk.LevelBar(min_value=0, max_value=1)
        # No low/high/full colours: a quiet setting isn't a warning.
        for name in (Gtk.LEVEL_BAR_OFFSET_LOW, Gtk.LEVEL_BAR_OFFSET_HIGH, "full"):
            self.bar.remove_offset_value(name)
        self.level.append(self.bar)
        for widget in self.level:
            box.pack_start(widget, False, False, 0)
        # The slider's widgets, shown only when the wheel can't reach the
        # headphones (see open()).
        self.slider = [Gtk.Separator(),
                       Gtk.Label(label="Headphone volume", xalign=0)]
        box.pack_start(self.slider[0], False, False, 2)
        box.pack_start(self.slider[1], False, False, 0)
        self.scale = Gtk.Scale.new_with_range(
            Gtk.Orientation.HORIZONTAL, 0, HEADSET_MAX, 1)
        self.scale.set_size_request(200, -1)
        self.scale.set_value_pos(Gtk.PositionType.RIGHT)
        self.scale.connect("format-value",
                           lambda _s, v: f"{round(v * 100 / HEADSET_MAX)}%")
        self.scale.connect("value-changed", self.on_scale_changed)
        box.pack_start(self.scale, False, False, 0)
        self.slider.append(self.scale)

        frame = Gtk.Frame(shadow_type=Gtk.ShadowType.OUT)
        frame.add(box)
        self.add(frame)
        frame.show_all()

        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.KEY_PRESS_MASK)
        self.connect("button-press-event", self.on_button_press)
        self.connect("key-press-event", self.on_key_press)
        self.connect("grab-broken-event", lambda *a: self.close())
        self.connect("delete-event", lambda *a: self.hide() or True)

    def open(self):
        self.app.refresh()
        self.app.check_wheel()
        wheel = self.app.drives_headset
        for widget in self.slider:
            widget.set_visible(not wheel)
        self.update_level_visibility()
        if not wheel:
            self.read_headset()
        self.resize(1, 1)         # shrink back after the slider goes
        self.place()
        self.show()
        seat = Gdk.Display.get_default().get_default_seat()
        status = seat.grab(self.get_window(), Gdk.SeatCapabilities.ALL, True,
                           None, None, None, None)
        if status != Gdk.GrabStatus.SUCCESS:
            log(f"popup: can't grab the pointer ({status.value_nick})")

    def close(self):
        if self.get_visible():
            Gdk.Display.get_default().get_default_seat().ungrab()
            self.hide()

    def place(self):
        """Next to the tray icon: below it on a top panel, above it on a
        bottom one, kept on the monitor."""
        size = self.get_preferred_size()[1]
        width, height = size.width, size.height
        ok, _screen, area, _orient = self.app.icon.get_geometry()
        if not ok:
            self.set_position(Gtk.WindowPosition.MOUSE)
            return
        work = Gdk.Display.get_default().get_monitor_at_point(
            area.x, area.y).get_workarea()
        x = area.x + area.width // 2 - width // 2
        x = max(work.x, min(x, work.x + work.width - width))
        if area.y < work.y + work.height // 2:
            y = area.y + area.height
        else:
            y = area.y - height
        self.move(x, y)

    def on_button_press(self, _win, event):
        # With the grab, clicks anywhere on screen arrive here. Ours have
        # already gone to the widgets under them; close on any other.
        ox, oy = self.get_window().get_origin()[1:]
        width, height = self.get_size()
        if not (ox <= event.x_root < ox + width and oy <= event.y_root < oy + height):
            self.close()
            return True
        return False

    def on_key_press(self, _win, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def show_port(self, port):
        self.updating = True
        (self.headphones if port == HEADPHONES else self.speaker).set_active(True)
        self.updating = False

    def show_level(self, on_hp, volume):
        """The volume (0..1 or None), as the tooltip has it."""
        self.level_on_hp = on_hp
        if volume is None:
            self.bar.set_value(0)
            self.level_value.set_text("?")
        else:
            self.bar.set_value(volume)
            self.level_value.set_text(f"{round(volume * 100)}%")
        self.update_level_visibility()

    def update_level_visibility(self):
        # On the headphones without the wheel, the slider shows that level.
        visible = self.app.drives_headset or not self.level_on_hp
        if visible != self.bar.get_visible():
            for widget in self.level:
                widget.set_visible(visible)
            if self.get_visible():
                self.resize(1, 1)
                self.place()

    def on_port_toggled(self, button, port):
        if button.get_active() and not self.updating:
            self.app.set_port(port)

    def read_headset(self):
        def got(ok, out):
            value = amixer_value(out) if ok else None
            if value is None:
                log(f"can't read {HEADSET_VOLUME}: {out.strip()}")
                return
            self.show_headset(value)
        run(["amixer", "-c", CARD, "cget", f"name={HEADSET_VOLUME}"], got)

    def show_headset(self, value):
        self.updating = True
        self.scale.set_value(value)
        self.updating = False

    def on_scale_changed(self, scale):
        if not self.updating:
            self.queue_headset(round(scale.get_value()))

    def queue_headset(self, value):
        # A drag fires many changes; run one amixer at a time
        # and send only the latest value when it finishes.
        self.hs_pending = value
        if not self.hs_busy:
            self.write_headset()

    def write_headset(self):
        value, self.hs_pending = self.hs_pending, None
        self.hs_busy = True

        def done(ok, out):
            self.hs_busy = False
            if self.hs_pending is not None:
                self.write_headset()
        run(["amixer", "-q", "-c", CARD, "cset", f"name={HEADSET_VOLUME}",
             str(value)], done)


def main():
    if not aess_kernel():
        log("unsupported: this kernel uses the direct McPDM audio path; "
            "pyra-sound needs an AESS kernel (5.6.19-m4*)")
        return 0
    return PyraSound().run(sys.argv)


